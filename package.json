  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/app.browser.cjs",
    "build:web": "node scripts/build-web.cjs",
    "pretest:web": "npm run build:web",
    "test:web": "node --test tests/web-artifact.cjs",
